APP_NAME=HustleStore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# SEO / Store Metadata
SEO_TAGLINE="Top Up Game, Pulsa & Voucher Streaming Termurah"
SEO_DESCRIPTION="HustleStore adalah platform top up game, isi pulsa, paket data, token PLN, e-money, dan voucher streaming (Netflix, Spotify, dan lainnya) termurah, tercepat, otomatis 24 jam, dan aman."
SEO_KEYWORDS="top up game, top up murah, pulsa murah, paket data, voucher game, mobile legends, free fire, pubg mobile, genshin impact, valorant, netflix, spotify, disney hotstar, token pln, e-money, hustlestore"
SEO_OG_IMAGE="assets/media/hustle/og-image.png"
SEO_LOGO="assets/media/logos/logo_store.png"
SEO_FAVICON="assets/media/logos/favicon.png"
SEO_THEME_COLOR="#7C3AED"
SEO_LOCALE="id_ID"
SEO_TWITTER="@hustlestore"
SEO_WHATSAPP="6281234567890"
SEO_EMAIL="support@hustlestore.id"

# VIPayment (vip-reseller.co.id) — dipakai untuk sinkron daftar harga (php artisan vip:sync)
VIPAYMENT_API_ID=
VIPAYMENT_API_KEY=
VIPAYMENT_PRICE_TIER=basic

# Akun superadmin awal (dipakai db:seed). Kosongkan password = dibuatkan acak & ditampilkan saat seed.
SUPERADMIN_EMAIL=superadmin@gmail.com
SUPERADMIN_PASSWORD=
